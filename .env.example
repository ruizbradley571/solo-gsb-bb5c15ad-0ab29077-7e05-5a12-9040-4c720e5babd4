# /secure-request 鉴权配置示例：复制为 .env 后替换为真实密钥。
# 逗号分隔的 key_id=secret 列表（secret 为原始 UTF-8 字节，
# 建议使用 32 字节随机值的 hex/base64 文本，避免逗号与等号字符）。
SECURE_REQUEST_KEYS=demo-key=0123456789abcdef0123456789abcdef,backup-key=replace-me-with-a-strong-secret

# 允许的请求时间戳与服务端时间的最大偏差（秒）
SECURE_REQUEST_TIMESTAMP_SKEW=300

# 同一 key_id+nonce 的基础防重放保留窗口（秒），默认取 2 倍时间偏差。
# 实际保留到期时刻会自动顺延到“配置 TTL 到期”与“该信封时间戳允许的最晚
# 验收时刻（timestamp+SECURE_REQUEST_TIMESTAMP_SKEW）”两者中较晚者，
# 因此 TTL 配置得比时间偏差小也不会在信封仍可验收期间放过重放；信封时间
# 窗结束且保留期届满后 nonce 才允许复用。
SECURE_REQUEST_NONCE_TTL=600

# nonce 防重放表的容量上限（进行中占位与窗口内已成功 nonce 合计）。
# 容量已满且无过期项时 /secure-request 返回 503 nonce_capacity_exceeded，
# 不会驱逐任何未过期 nonce；必须为正整数，默认 10000。
SECURE_REQUEST_NONCE_CAPACITY=10000
